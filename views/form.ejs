<%- include('partials/header.ejs') %>

<div class="container d-flex justify-content-center align-items-center" style="min-height:90vh; flex-direction: column;">
  <h1 class="text-center mb-4 text-white">
    <%= post ? "Edit Post" : "Create Post" %>
  </h1>
  
  <form action="<%= post ? '/edit/' + post.id : '/post' %>" method="post" class="w-50 bg-dark p-4 rounded">
    <div class="mb-3">
      <label for="title" class="form-label text-white">Title</label>
      <input type="text" name="title" id="title" class="form-control" 
             placeholder="Enter title" value="<%= post ? post.title : '' %>">
    </div>
    
    <div class="mb-3">
      <label for="info" class="form-label text-white">Info</label>
      <textarea name="info" id="info" class="form-control" rows="5" placeholder="Enter info"><%= post ? post.info : '' %></textarea>
    </div>
    
    <div class="d-grid">
      <button type="submit" class="btn btn-primary">
        <%= post ? "Update" : "Submit" %>
      </button>
    </div>
  </form>
</div>

<%- include('partials/footer.ejs') %>
